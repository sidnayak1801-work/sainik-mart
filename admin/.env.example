# Local API. Production builds default to https://api.sainikmartapp.in if unset.
# Production: VITE_API_URL=https://api.sainikmartapp.in
VITE_API_URL=http://localhost:4000

# Public Firebase web app + Cloud Messaging VAPID key. If any is missing, admin
# shows a setup message and does not prompt for notification permission.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
