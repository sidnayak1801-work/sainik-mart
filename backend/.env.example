NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sainik_mart?schema=public
# JWT secret (JWT_SECRET is accepted as an alias)
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
# Optional. Leave empty to allow all origins in development.
CORS_ORIGIN=
# Optional. Required for POST /api/admin/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Razorpay Checkout (test or live). RAZORPAY_API_KEY is accepted as an alias for KEY_ID.
# Never commit real keys. Never put KEY_SECRET in the mobile app or admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Firebase Admin (backend only). Never put these in the mobile app or commit real values.
# FIREBASE_PRIVATE_KEY may use escaped newlines: -----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
