NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sainik_mart?schema=public
# JWT secret (JWT_SECRET is accepted as an alias)
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=7d
# Optional. Leave empty to allow all origins in development.
CORS_ORIGIN=
# Optional. Required for POST /api/admin/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Razorpay Checkout (test or live). RAZORPAY_API_KEY is accepted as an alias for KEY_ID.
# Never commit real keys. Never put KEY_SECRET in the mobile app or admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Firebase Admin (backend only). Never put these in the mobile app or commit real values.
# FIREBASE_PRIVATE_KEY may use escaped newlines: -----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Customer OTP. mock is for local/tests only. Widget login uses MSG91_AUTH_KEY to verify the widget access token.
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_HMAC_SECRET=
# Backend Authkey from the MSG91 widget server-integration dropdown. Never put this in the mobile app.
MSG91_AUTH_KEY=
# Optional. Only needed for the legacy send-OTP API + custom DLT templates, not DefaultWidget.
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
