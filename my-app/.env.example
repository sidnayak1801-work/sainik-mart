# Local Expo (`npm start` / Simulator): this Mac's API.
# Expo web / iOS Simulator: http://127.0.0.1:4000
# Physical phone on Expo Go: use your Mac LAN IP (not localhost).
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# EAS preview + production Android builds bake this HTTPS URL (see my-app/eas.json).
# Do not use 127.0.0.1 in a store/APK build.
# EXPO_PUBLIC_API_URL=https://api.sainikmartapp.in

# MSG91 DefaultWidget (client). tokenAuth is the widget token, NOT MSG91_AUTH_KEY.
# Expo Go cannot run this SDK. Use a native build: npx expo run:ios / run:android.
EXPO_PUBLIC_MSG91_WIDGET_ID=366a6a677531333531303937
EXPO_PUBLIC_MSG91_WIDGET_AUTH_TOKEN=
