# Public website configuration. Copy to .env before local development.
# Only VITE_ values are exposed to the browser. Never put API secrets,
# database URLs, JWT keys, or admin credentials here.
#
# Vite bakes these values at build time. After changing them on the server,
# run `npm run build` and restart the web process.

# apk | playstore | coming_soon
# Play Store still requires this to be `playstore`.
# A non-empty HTTPS VITE_ANDROID_APK_URL is enough for Install to open that link.
VITE_APP_DISTRIBUTION_MODE=coming_soon

# HTTPS URL the Install button opens. Direct .apk files start a download in
# Android Chrome. Expo/HTML pages open in the browser instead of a file save.
# Do not use an Expo development (exp://) URL.
VITE_ANDROID_APK_URL=

# Official Play Store listing. Used when VITE_APP_DISTRIBUTION_MODE=playstore.
VITE_PLAY_STORE_URL=

# Optional overrides
VITE_SITE_URL=https://sainikmartapp.in
VITE_DOWNLOAD_LABEL=Install App

# Optional contact fields. Leave empty rather than inventing details.
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
